# ══════════════════════════════════════════════════════════════
#  fapiao_web · 版本控制忽略清单
#  ⚠️ 核心原则：真实发票数据绝不允许进入版本库或任何发布包
# ══════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/

# ── 运行日志与临时产物 ────────────────────────────────────────
*.log
_selftest.bat
data/

# ── 测试输出目录 ─────────────────────────────────────────────
# ⚠️ 里面是「用真实发票跑出来的行程单/报告」，含真实业务数据，同样不入库
_out/

# ── 【重要】测试样本：用户的真实发票 ─────────────────────────
# 仅供本地跑测试，永不提交、永不打包、永不外发
tests/samples/

# ── 【重要】样本去重隔离区 ───────────────────────────────────
# 与 tests/samples/ 同为真实发票副本（字节重复件），只移不删，
# 保留原相对路径便于还原（restore.py）。绝不入库、绝不打包。
tests/_quarantine_dups/

# ── 走查截图（体积大，随时可重新生成）────────────────────────
dev_shots/
backup/

# ── 编辑器 / 操作系统杂项 ────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
~$*

build/
dist/
.venv/
