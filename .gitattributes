# ══════════════════════════════════════════════════════════════
#  fapiao_web · 换行符与编码规则
#  目的：防止 git 自动转换破坏关键文件的字节（尤其是 .bat）
# ══════════════════════════════════════════════════════════════

# 默认：文本文件在库里统一用 LF
* text=auto eol=lf

# ── 【铁律】.bat 必须是 GBK 编码 + CRLF 换行 ──────────────────
# cmd.exe 按系统 ANSI 代码页（简中=GBK/936）解析 bat；
# 若被 git 转成 LF 或 UTF-8，双击启动会报「不是内部或外部命令」。
# 因此标记为 -text：git 不做任何换行/编码转换，原样保存。
*.bat  -text
*.cmd  -text

# ── 二进制资源 ───────────────────────────────────────────────
*.exe  binary
*.dll  binary
*.ico  binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.zip  binary
*.ttf  binary

# ── 字体文件 ─────────────────────────────────────────────────
*.otf  binary
